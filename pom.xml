<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>md.impact</groupId>
    <artifactId>lectia8</artifactId>
    <version>1.0</version>
    <name>Lecția 8 · Biblioteci (JUnit și Swing)</name>

    <properties>
        <!-- Versiunea Java. Dacă elevii au Java 11, schimbați în 11 -->
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- Biblioteca JUnit 5: doar pentru teste (scope test) -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.11.0</version>
            <scope>test</scope>
        </dependency>
        <!-- Swing NU se adaugă aici: vine împreună cu Java (javax.swing) -->
    </dependencies>

    <build>
        <plugins>
            <!-- Necesar ca "mvn test" să găsească testele JUnit 5 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
        </plugins>
    </build>
</project>
